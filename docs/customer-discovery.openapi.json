{
  "openapi": "3.0.0",
  "info": {
    "title": "Fashion ERP customer discovery contract",
    "version": "1"
  },
  "paths": {
    "/api/v1/customer-portal/catalog/discover": {
      "get": {
        "operationId": "CustomerCatalogController_discover_v1",
        "parameters": [
          {
            "in": "query",
            "name": "companyId",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "query",
            "required": false,
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "color",
            "required": false,
            "schema": {
              "maxLength": 40,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "maxLength": 40,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "maxPrice",
            "required": false,
            "schema": {
              "pattern": "^\\d{1,10}(?:\\.\\d{1,2})?$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "currency",
            "required": false,
            "schema": {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "enum": [
                "exact",
                "similar"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "maximum": 10000,
              "minimum": 0,
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "exclude",
            "required": false,
            "schema": {
              "maxLength": 2220,
              "pattern": "^[a-fA-F0-9,-]*$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "Customer Portal (Bot Integration)"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "Supply a valid JWT access token in the Authorization header as: Bearer <JWT>.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  }
}
