meta {
  name: 03 Dashboard Denied Company
  type: http
  seq: 3
  tags: [
    reports
    dashboard
    scope
    security
  ]
}

get {
  url: {{baseUrl}}/api/v1/reports/dashboard?companyId={{deniedCompanyId}}&fromDate={{fromDate}}&toDate={{toDate}}
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("dashboard denied company returns 403", function() {
    expect(res.status).to.equal(403);
  });
}
