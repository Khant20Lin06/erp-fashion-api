meta {
  name: 02 Dashboard Denied Branch
  type: http
  seq: 2
  tags: [
    reports
    dashboard
    scope
    security
  ]
}

get {
  url: {{baseUrl}}/api/v1/reports/dashboard?companyId={{companyId}}&branchId={{deniedBranchId}}&fromDate={{fromDate}}&toDate={{toDate}}
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("dashboard denied branch returns 403", function() {
    expect(res.status).to.equal(403);
  });
}
