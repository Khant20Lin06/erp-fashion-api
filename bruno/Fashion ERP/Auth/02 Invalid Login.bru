meta {
  name: 02 Invalid Login
  type: http
  seq: 2
  tags: [
    auth
    security
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  auth: none
}

headers {
  content-type: application/json
}

body {
  {
    "email": "{{authEmail}}",
    "password": "wrong-password"
  }
}

tests {
  test("invalid login returns 401", function() {
    expect(res.status).to.equal(401);
  });
}
