# Application
NODE_ENV=development
APP_ROLE=all
PORT=3000
API_PREFIX=api
API_VERSION=1
APP_NAME=Fashion ERP Backend

# CORS (comma-separated list of allowed origins, e.g. http://localhost:3001,https://app.example.com)
CORS_ORIGINS=

# Logging
LOG_LEVEL=info
ENABLE_SWAGGER=true
SWAGGER_PATH=docs
SWAGGER_JSON_PATH=docs-json
HTTP_BODY_LIMIT=1mb
METRICS_ENABLED=true
METRICS_PATH=metrics
READINESS_TIMEOUT_MS=3000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_HEADERS_TIMEOUT_MS=60000

# Express trust proxy (Phase 20). Empty = trust nothing (safe default for
# local dev / no reverse proxy). Set to a hop count like "1" when deployed
# behind exactly one reverse proxy (nginx/Caddy/Traefik/load balancer) so
# request.ip reflects the real client, not the proxy. docker-compose.prod.yml
# sets this to "1" for the api service.
TRUST_PROXY=

# Docker host port mappings (change if these conflict with something else on your machine)
API_HOST_PORT=4000
DB_HOST_PORT=3306
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9094

# Database (MySQL) - used by both the API and docker-compose's mysql service
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=fashion_erp
DB_PASSWORD=fashion_erp
DB_DATABASE=fashion_erp
DB_ROOT_PASSWORD=fashion_erp_root
DB_POOL_SIZE=10
DB_LOGGING=false
DB_CONNECT_TIMEOUT_MS=10000

# Redis (Phase 19 — cache only, never a source of truth; Phase 20 reuses the
# same connection for BullMQ). REDIS_PASSWORD is optional (local dev redis
# runs without auth). REDIS_DB is the logical database index (0-15).
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000

# Kafka (Phase 18 — transactional outbox / event transport). KAFKA_BROKERS
# is a comma-separated list; when running via docker-compose, the api
# service overrides this to kafka:9092 (the in-network address) — the
# localhost:${KAFKA_HOST_PORT} value below is for running the API directly
# on the host against the dockerized broker.
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=fashion-erp-api
KAFKA_GROUP_ID=erp-payment-audit-consumer
KAFKA_CONNECTION_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=30000

# Outbox publisher polling (Phase 18)
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50

# Authentication (Phase 05) - JWT_SECRET must be a strong random value in every real environment.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_ISSUER=fashion-erp-backend
JWT_AUDIENCE=fashion-erp-frontend

# Cookie carrying the access token. In production this must be secure=true and
# sameSite should reflect the actual frontend/backend origin relationship.
AUTH_COOKIE_NAME=fashion_erp_access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/

PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=30
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Workers / queues
NOTIFICATION_WORKER_CONCURRENCY=3
WEBHOOK_WORKER_CONCURRENCY=3
AI_INGESTION_WORKER_CONCURRENCY=2

# AI Assistant / RAG (Phase 19, hybrid provider fallback added Phase 19.1).
# AI_ENABLED gates the whole feature; with no provider configured the ERP
# remains fully functional. No default for AI_BASE_URL/AI_API_KEY/
# AI_CHAT_MODEL/AI_EMBEDDING_MODEL — never assume a specific provider.
#
# Provider priority at request time (HybridLlmProvider):
#   1. Remote LLM (AI_BASE_URL/AI_API_KEY/AI_CHAT_MODEL) if configured+healthy
#   2. Local LLM (OLLAMA_BASE_URL/OLLAMA_CHAT_MODEL) if configured+healthy —
#      fully optional, no API key needed, safe to leave unset
#   3. Local deterministic ERP-tool/RAG fallback (AI_FALLBACK_ENABLED) — the
#      assistant stays usable with zero external credentials configured
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
OLLAMA_BASE_URL=
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=
AI_FALLBACK_ENABLED=true
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_HISTORY_MESSAGES=20
AI_RAG_TOP_K=5
AI_CHUNK_SIZE=1000
AI_CHUNK_OVERLAP=150
AI_CHAT_RATE_LIMIT_PER_MINUTE=10

# Database backup (Phase 20 — see docs/BACKUP_RECOVERY.md and scripts/backup-database.sh)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6
