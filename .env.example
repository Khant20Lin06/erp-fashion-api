# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
APP_NAME=Fashion ERP Backend

# CORS (comma-separated list of allowed origins, e.g. http://localhost:3001,https://app.example.com)
CORS_ORIGINS=

# Logging
LOG_LEVEL=info

# Docker host port mappings (change if these conflict with something else on your machine)
API_HOST_PORT=4000
DB_HOST_PORT=3306
REDIS_HOST_PORT=6379

# Database (MySQL) - used by both the API and docker-compose's mysql service
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=fashion_erp
DB_PASSWORD=fashion_erp
DB_DATABASE=fashion_erp
DB_ROOT_PASSWORD=fashion_erp_root
DB_POOL_SIZE=10
DB_LOGGING=false

# Redis - used by docker-compose's redis service (application integration is Phase 19)
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication (Phase 05) - JWT_SECRET must be a strong random value in every real environment.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_ISSUER=fashion-erp-backend
JWT_AUDIENCE=fashion-erp-frontend

# Cookie carrying the access token. In production this must be secure=true and
# sameSite should reflect the actual frontend/backend origin relationship.
AUTH_COOKIE_NAME=fashion_erp_access_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/

PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=30
