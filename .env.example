# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
APP_NAME=Fashion ERP Backend

# CORS (comma-separated list of allowed origins, e.g. http://localhost:3001,https://app.example.com)
CORS_ORIGINS=

# Logging
LOG_LEVEL=info

# The following will be added in future phases and are not used yet:
# DATABASE_URL / DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD / DB_DATABASE (Phase 03)
# REDIS_URL (Phase 19)
# JWT_SECRET / JWT_REFRESH_SECRET (Phase 05)
